# Copy to .env and adjust. Every variable has a default; this file shows them all.

# ===== Service =====
# DEBUG | INFO | WARNING | ERROR (logs go to stdout)
LOG_LEVEL=INFO
# Max size of one uploaded file, MB (bigger -> 413). /passport and /hr/passport take two files.
MAX_UPLOAD_MB=10

# ===== Tesseract =====
# Folder with tgk/eng/ocrb .traineddata. In Docker it is the /models volume.
TESSDATA_DIR=/models/tessdata
# Path to the tesseract binary if it is not on PATH (not needed in Docker)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Language of /ocr: tgk, or tgk+rus for mixed text (then rus.traineddata must be in TESSDATA_DIR)
TESSERACT_LANG=tgk
# Page layout of /ocr: 3 = automatic (columns, blocks), 6 = one block of text
TESSERACT_PSM=3
# Parallel Tesseract processes per passport request; set to the number of CPU cores
OCR_THREADS=2

# ===== /ocr defaults (can be overridden per request with ?flatten=&deskew=&min_score=) =====
OCR_FLATTEN=true
OCR_DESKEW=true
OCR_MIN_SCORE=0.0

# ===== Server (read by uvicorn, not by the app) =====
# Path prefix behind nginx: Swagger opens at /ocr/docs. nginx must strip the prefix (see DEPLOY.md).
UVICORN_ROOT_PATH=/ocr
