# ===== Общие =====
# Ключ доступа: если задан, все запросы к /ocr и /passport требуют заголовок X-API-Key
# API_KEY=придумай-длинный-ключ
# Движок по умолчанию: tesseract | paddle  (в запросе можно переопределить: /ocr?engine=paddle)
OCR_ENGINE=tesseract
# Выравнивать неравномерное освещение / тени перед распознаванием
OCR_FLATTEN=true
# Выпрямлять наклонный текст (до 15°)
OCR_DESKEW=true
# Отбрасывать строки с уверенностью ниже (0..1)
OCR_MIN_SCORE=0.0
OCR_MAX_UPLOAD_MB=15

# ===== Tesseract =====
# Путь к tesseract.exe, если его нет в PATH (по умолчанию ищется C:\Program Files\Tesseract-OCR\tesseract.exe)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# tgk = таджикский; tgk+rus — для смешанного текста
TESSERACT_LANG=tgk
# 3 = автоматическая разметка страницы (колонки, блоки), 6 = один блок текста
TESSERACT_PSM=3

# ===== PaddleOCR (нужно: uv sync --extra paddle) =====
OCR_LANG=tg
# cpu | gpu:0
OCR_DEVICE=cpu
# oneDNN ускоряет CPU, но на некоторых сборках Paddle под Windows падает
OCR_ENABLE_MKLDNN=false
OCR_TEXTLINE_ORIENTATION=false
# Своя дообученная модель распознавания
# OCR_REC_MODEL_DIR=./models/tajik_rec
